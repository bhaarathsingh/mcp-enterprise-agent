# Configure OAuth with `databricks auth login`; do not put credentials in Git.
# The CLI does not automatically load this file. Export these values in your shell.
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_MODEL_ENDPOINT=your-tool-calling-model-endpoint
MCP_AUDIT_PATH=logs/audit.jsonl
# Local process-level role simulation, never an HTTP authentication mechanism.
MCP_DEMO_PRINCIPAL=analyst-east
